# Copy to .env for local runs. Never commit .env.
# Supabase > Connect > "Session pooler" connection string (IPv4-compatible)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-me-to-a-long-random-string
# Only used the very first time, to create the admin account on an empty database
INITIAL_ADMIN_PASSWORD=
APP_TZ=Asia/Kolkata
